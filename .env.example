# Canonical site origin used in metadata, sitemap, and structured data.
# Leave unset to use https://fisiolab.eu.
NEXT_PUBLIC_SITE_URL=https://fisiolab.eu

# Google Analytics 4 measurement ID. Leave empty until after launch.
# When this is set, the site shows a consent banner and loads GA4 only after Accept.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
